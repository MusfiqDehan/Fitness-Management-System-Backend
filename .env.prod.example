# Backend production environment template.
# Copy to .env.prod on the server and fill in secrets.
# Path: /srv/fullstacks/Fitness-Management-System/backend/.env.prod

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=fitness.musfiqdehan.com,.fitness.musfiqdehan.com
PORT=8021

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://gym_user:change-me@pgbouncer:6432/gym_db
DIRECT_DATABASE_URL=postgresql://gym_user:change-me@db:5432/gym_db
USE_PGBOUNCER=1
DB_CONN_MAX_AGE=0
BACKUP_DIR=/var/backups/gym-postgres
DB_HOST=db
DB_PORT=5432
DB_USER=gym_user
DB_PASSWORD=change-me
DB_NAME=gym_db

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://fitness.musfiqdehan.com
CORS_ALLOWED_ORIGIN_REGEXES=^https://([a-z0-9-]+\.)?fitness\.musfiqdehan\.com$
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=https://fitness.musfiqdehan.com,https://*.fitness.musfiqdehan.com
SECURE_SSL_REDIRECT=false

# ── Multi-tenancy ────────────────────────────────────────────────────────────
PUBLIC_DOMAIN=fitness.musfiqdehan.com
TENANT_BASE_DOMAIN=fitness.musfiqdehan.com
TENANT_ROOT_DOMAIN=fitness.musfiqdehan.com
FRONTEND_BASE_URL=https://fitness.musfiqdehan.com
PUBLIC_FRONTEND_URL=https://fitness.musfiqdehan.com
BACKEND_BASE_URL=https://fitness.musfiqdehan.com
TENANT_FRONTEND_BASE_DOMAIN=fitness.musfiqdehan.com
TENANT_FRONTEND_SCHEME=https
TENANT_FRONTEND_PORT=
TENANT_POST_LOGIN_PATH=/dashboard
TENANT_ONBOARDING_LINKS_PUBLIC=false
CUSTOM_DOMAIN_CNAME_TARGET=fitness.musfiqdehan.com
CUSTOM_DOMAIN_A_TARGET=213.199.63.131
TRAEFIK_CUSTOM_DOMAINS_PATH=/traefik-dynamic/custom-domains.yml
SHOW_PUBLIC_IF_NO_TENANT_FOUND=true
AUTO_CREATE_DEFAULT_TENANT=false

# ── Superadmin ───────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@fitness.musfiqdehan.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_SCHEMA=public

# ── Device integration ───────────────────────────────────────────────────────
GYM_DEVICE_API_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fitness.musfiqdehan.com
CONTACT_EMAIL=hi@musfiqdehan.com
EMAIL_TIMEOUT=15

# ── Optional tuning ──────────────────────────────────────────────────────────
WEB_CONCURRENCY=3
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
CONN_MAX_AGE=600

# ── Stripe (platform SaaS billing + seed credentials) ───────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ── DRF Rate limiting ────────────────────────────────────────────────────────
THROTTLE_BURST_ANON=20/min
THROTTLE_BURST_USER=60/min
THROTTLE_SUSTAINED_ANON=500/hour
THROTTLE_SUSTAINED_USER=2000/hour
