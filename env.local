# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-local-dev-key-replace-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
PORT=8021

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=gym_db_local
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password_local
DATABASE_URL=postgresql://gym_user:gym_password_local@db:5432/gym_db_local

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

