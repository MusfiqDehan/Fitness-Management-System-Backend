# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
DEBUG=false
ALLOWED_HOSTS=your-api-domain.com
PORT=8021

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://gym_user:CHANGE_THIS_STRONG_DB_PASSWORD@db:5432/gym_db

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://your-domain.com

