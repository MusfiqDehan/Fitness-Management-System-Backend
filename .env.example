# Backend environment template.
# Copy this file to .env.local for local development or to .env.prod for production.

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
PORT=8021

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
# Production: point at PgBouncer (session pool). Migrations use DIRECT_DATABASE_URL.
DATABASE_URL=postgresql://gym_user:gym_password@pgbouncer:6432/gym_db
DIRECT_DATABASE_URL=postgresql://gym_user:gym_password@db:5432/gym_db
USE_PGBOUNCER=1
DB_CONN_MAX_AGE=0
BACKUP_DIR=/var/backups/gym-postgres
# PgBouncer container (edoburu/pgbouncer reads these via env_file).
# docker-compose.prod.yml clears DATABASE_URL for the pgbouncer service and sets
# LISTEN_PORT=6432 so the pooler listens on 6432 while proxying to db:5432.
DB_HOST=db
DB_PORT=5432
DB_USER=gym_user
DB_PASSWORD=gym_password
DB_NAME=gym_db
# Django fallback when DATABASE_URL unset (local manual dev)

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false

# ── Multi-tenancy ────────────────────────────────────────────────────────────
# Local defaults below. Production (.env.prod) should use:
#   PUBLIC_DOMAIN=fitness.musfiqdehan.com
#   TENANT_BASE_DOMAIN=fitness.musfiqdehan.com
#   TENANT_ROOT_DOMAIN=fitness.musfiqdehan.com
#   FRONTEND_BASE_URL=https://fitness.musfiqdehan.com
#   PUBLIC_FRONTEND_URL=https://fitness.musfiqdehan.com
#   BACKEND_BASE_URL=https://fitness.musfiqdehan.com
#   TENANT_FRONTEND_BASE_DOMAIN=fitness.musfiqdehan.com
#   TENANT_FRONTEND_SCHEME=https
#   TENANT_FRONTEND_PORT=
PUBLIC_DOMAIN=localhost
TENANT_BASE_DOMAIN=localhost
TENANT_ROOT_DOMAIN=localhost
FRONTEND_BASE_URL=http://localhost:5174
PUBLIC_FRONTEND_URL=http://localhost:5174
# URL of THIS backend's public API — used for payment gateway callbacks
# (success/fail/cancel/ipn for SSLCommerz; success/cancel for Stripe Checkout).
# Must be reachable by the payment gateway server.
# Local: http://localhost:8021
# Production: https://fitness.musfiqdehan.com  (single fixed URL, NOT tenant-specific)
BACKEND_BASE_URL=http://localhost:8021

# Stripe platform keys (sandbox/test by default). Also configurable in Platform → Billing.
# Toggle sandbox/live on the PaymentGateway row and use matching pk_test_/sk_test_ or pk_live_/sk_live_ keys.
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Optional: pin Stripe API version (leave blank to use the SDK default)
# STRIPE_API_VERSION=2026-06-24.dahlia
TENANT_FRONTEND_BASE_DOMAIN=localhost
TENANT_FRONTEND_SCHEME=http
TENANT_FRONTEND_PORT=5174
TENANT_POST_LOGIN_PATH=/dashboard
TENANT_ONBOARDING_LINKS_PUBLIC=false
# Custom-domain routing targets (shown after TXT verification). CNAME preferred.
# Production: CUSTOM_DOMAIN_CNAME_TARGET=fitness.musfiqdehan.com
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_A_TARGET=
# Traefik dynamic config for verified custom domains (Host() + HTTP-01 ACME).
TRAEFIK_CUSTOM_DOMAINS_PATH=/traefik-dynamic/custom-domains.yml
SHOW_PUBLIC_IF_NO_TENANT_FOUND=true
AUTO_CREATE_DEFAULT_TENANT=true
DEFAULT_TENANT_SCHEMA=gym_local
DEFAULT_TENANT_NAME=Local Gym
DEFAULT_TENANT_SLUG=local-gym
DEFAULT_TENANT_CODE=LOCAL
DEFAULT_TENANT_DOMAINS=local-gym.localhost

# ── Superadmin ───────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_SCHEMA=public

# ── Device integration ───────────────────────────────────────────────────────
GYM_DEVICE_API_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_TIMEOUT=15

# ── Optional tuning ──────────────────────────────────────────────────────────
WEB_CONCURRENCY=3
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
CONN_MAX_AGE=600

# ── DRF Rate limiting ────────────────────────────────────────────────────────
# Short-window burst guards (blocks rapid automated hits / scraping)
# Tighten these in production. Format: <count>/<period>  e.g. 20/min, 5/sec
THROTTLE_BURST_ANON=20/min
THROTTLE_BURST_USER=60/min
# Hourly volume caps (sustained traffic ceiling)
THROTTLE_SUSTAINED_ANON=500/hour
THROTTLE_SUSTAINED_USER=2000/hour